{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reht.dev/schemas/0.1/policy-context.schema.json",
  "title": "REHT Policy Context",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_set_id",
    "version",
    "effective_at",
    "rules"
  ],
  "properties": {
    "policy_set_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "jurisdiction": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regulatory_profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "legal_act_ref",
          "version",
          "jurisdiction",
          "effective_at",
          "active_obligation_ids",
          "evidence_refs",
          "accountable_owner_ref",
          "profile_digest"
        ],
        "properties": {
          "profile_id": {"type": "string", "minLength": 1},
          "legal_act_ref": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "jurisdiction": {"type": "string", "minLength": 1},
          "effective_at": {"type": "string", "format": "date-time"},
          "classification": {"type": ["string", "null"]},
          "active_obligation_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "accountable_owner_ref": {"type": "string", "minLength": 1},
          "profile_digest": {"type": "string", "minLength": 1}
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "effect"
        ],
        "properties": {
          "rule_id": {
            "type": "string"
          },
          "effect": {
            "type": "string",
            "enum": [
              "PERMIT",
              "PROHIBIT",
              "REQUIRE",
              "ESCALATE"
            ]
          },
          "condition_ref": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "racs_canonical": "https://racs.dev/schema/0.2/policy-context.yaml",
  "x-canonical-note": "REHT-specific profile. Regulatory applicability is evidence-bearing policy input and never execution authority. Runtime wire format, RACS-JCS-1 canonicalization and SHA-256 digest semantics are defined by the referenced RACS contract (issue #991)."
}
