{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reht.org/schemas/credential-delivery-interop-v1.schema.json",
  "title": "CredentialDeliveryInteropV1",
  "description": "Portable REHT interoperability envelope for clearance-bound credential delivery and sender-constrained execution. Complements (does not replace) ExecutionEnvelopeV1. Provider-neutral. Secret material is structurally prohibited.",
  "type": "object",
  "additionalProperties": false,
  "propertyNames": {
    "not": {
      "pattern": "secret|token|password|api_key|apiKey|credential_value|bearer|private_key"
    }
  },
  "required": [
    "schema_version",
    "clearance",
    "action",
    "workload_ref",
    "target_ref",
    "possession",
    "principal_id",
    "executor_id",
    "purpose_ref",
    "issued_at",
    "expires_at",
    "nonce",
    "receipt_requirements"
  ],
  "properties": {
    "schema_version": {"const": "CredentialDeliveryInteropV1"},
    "clearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clearance_id", "clearance_digest"],
      "properties": {
        "clearance_id": {"type": "string", "minLength": 1},
        "clearance_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_ref", "payload_digest"],
      "properties": {
        "action_ref": {"type": "string", "minLength": 1},
        "payload_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "workload_ref": {"type": "string", "minLength": 1},
    "target_ref": {"type": "string", "minLength": 1},
    "possession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation_key_thumbprint"],
      "properties": {
        "confirmation_key_thumbprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "principal_id": {"type": "string", "minLength": 1},
    "executor_id": {"type": "string", "minLength": 1},
    "purpose_ref": {"type": "string", "minLength": 1},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "minLength": 16},
    "scope_narrowing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "narrowed_resource_scope": {"type": "string", "minLength": 1},
        "narrowed_tool_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "receipt_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usage_receipt_required", "execution_receipt_required"],
      "properties": {
        "usage_receipt_required": {"const": true},
        "execution_receipt_required": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "description": "Validity containment: expires_at must not be earlier than issued_at.",
      "if": {"required": ["expires_at"]},
      "then": {
        "properties": {
          "expires_at": {"format": "date-time"}
        }
      }
    }
  ]
}